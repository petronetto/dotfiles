#!/usr/bin/env zsh

set -euo pipefail

# Installs any third-party skill listed in the committed manifest that's
# missing on disk. chezmoi re-runs this whenever the manifest's content
# changes (and once on first apply).
# skills.txt hash: {{ include "dot_agents/skills/skills.txt" | sha256sum }}

# Best-effort: never fail `chezmoi apply` over a network hiccup. The user can
# run `scripts/skills install` manually later.
"{{ .chezmoi.sourceDir }}/scripts/skills" install \
	|| echo "skills install: skipped/failed, run manually later"
