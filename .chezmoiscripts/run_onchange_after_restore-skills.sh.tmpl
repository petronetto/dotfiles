#!/usr/bin/env zsh

set -euo pipefail

# Reinstalls third-party agent skills recorded in the committed manifest.
# skill-lock hash: {{ include "dot_agents/.skill-lock.json" | sha256sum }}
# chezmoi re-runs this script whenever this hash changes (i.e. whenever the
# committed manifest changes) and once on first apply.

# Best-effort: never fail `chezmoi apply` if prerequisites are missing or the
# host is offline. The user can run `scripts/skills restore` manually later.
command -v jq >/dev/null 2>&1 || { echo "skills restore: jq missing, skipping"; exit 0; }
command -v node >/dev/null 2>&1 || { echo "skills restore: node missing, skipping"; exit 0; }
command -v npx >/dev/null 2>&1 || { echo "skills restore: npx missing, skipping"; exit 0; }

"{{ .chezmoi.sourceDir }}/scripts/skills" restore \
	|| echo "skills restore: skipped/failed, run manually later"
