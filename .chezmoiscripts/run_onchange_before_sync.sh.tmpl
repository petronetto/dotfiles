#!/usr/bin/env zsh

set -euo pipefail

# Private dotfiles repo state: {{ output "sh" "-c" `git ls-remote "${PRIVATE_DOTFILES_REPO:-git@github.com:petronetto/dotfiles-private.git}" HEAD 2>/dev/null | cut -f1 || echo none` | trim }}
# This hash represents the current HEAD of the remote private dotfiles repo
# (not a local clone, which may not exist on every machine). When new commits
# are pushed to that repo, this hash updates, triggering chezmoi to re-run
# this script on any machine.

"{{ .chezmoi.sourceDir }}/scripts/sync-private-dotfiles"
