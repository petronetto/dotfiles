#!/usr/bin/env zsh

set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
"{{ .chezmoi.sourceDir }}/scripts/macos/enable-touchid-sudo"
"{{ .chezmoi.sourceDir }}/scripts/macos/install-fn-f4-remap"
{{ else if eq .chezmoi.os "linux" -}}
"{{ .chezmoi.sourceDir }}/scripts/ubuntu/set-default-shell"
"{{ .chezmoi.sourceDir }}/scripts/ubuntu/configure-apple-keyboard"
"{{ .chezmoi.sourceDir }}/scripts/ubuntu/configure-gnome-shortcuts"
"{{ .chezmoi.sourceDir }}/scripts/ubuntu/configure-scroll-speed"
"{{ .chezmoi.sourceDir }}/scripts/ubuntu/install-touchpad-momentum"
{{ end -}}
