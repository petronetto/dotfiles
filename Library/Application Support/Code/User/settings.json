{
	"workbench.colorTheme": "Monokai Pro (Filter Ristretto)",
	"workbench.iconTheme": "material-icon-theme",
	"workbench.startupEditor": "newUntitledFile",
	"workbench.fontAliasing": "antialiased",
	"workbench.editorLargeFileConfirmation": 5120,
	"editor.fontFamily": "CaskaydiaCove NFP SemiLight",
	"editor.fontVariations": true,
	"editor.fontWeight": "340",
	"editor.fontSize": 14,
	"editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss19', 'ss20'",
	"editor.unicodeHighlight.nonBasicASCII": false,
	"editor.unicodeHighlight.ambiguousCharacters": false,
	"editor.autoClosingQuotes": "never",
	"editor.inlineSuggest.enabled": true,
	"editor.minimap.enabled": false,
	"editor.renderControlCharacters": true,
	"editor.renderWhitespace": "trailing",
	"terminal.integrated.fontFamily": "CaskaydiaCove NFP SemiLight, Menlo, Monaco",
	"terminal.integrated.fontSize": 14,
	"terminal.integrated.fontLigatures.enabled": true,
	"terminal.integrated.lineHeight": 1.3,
	"explorer.confirmDragAndDrop": false,
	"git.confirmSync": false,
	"git.enableSmartCommit": true,
	"security.workspace.trust.enabled": false,
	"files.exclude": {
		"**/.git": true,
		"**/.DS_Store": true,
		"**/.idea": true,
		"**/.vscode": true,
		"**/.venv": true,
		"**/.ipynb_checkpoints": true,
		"**/__pycache__": true,
		"**/.pytest_cache": true,
		"**/*.pyc": true,
		"**/*.map": true,
		"**/*.js": {
			"when": "$(basename).ts"
		}
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/vendor": true,
		"**/__pycache__": true,
		"**/.venv": true
	},
	"security.workspace.trust.untrustedFiles": "open",
	"terminal.external.osxExec": "ghostty",
	"workbench.editor.empty.hint": "hidden",
	"files.associations": {
		"config": "ini"
	},
	"telemetry.feedback.enabled": false,
	"github.copilot.nextEditSuggestions.enabled": true,
	"files.trimTrailingWhitespace": true,
	"github.copilot.enable": {
		"*": true,
		"plaintext": false,
		"markdown": true,
		"scminput": false
	},
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	"github.copilot.chat.anthropic.tools.websearch.enabled": true,
	"claudeCode.preferredLocation": "panel",
	"git.openRepositoryInParentFolders": "never",
	"docker.extension.dockerEngineAvailabilityPrompt": false,
	"intelephense.diagnostics.deprecated": false,
	"redhat.telemetry.enabled": true,
	"docker.extension.enableComposeLanguageServer": false,
	"chat.viewSessions.orientation": "stacked",
	"diffEditor.ignoreTrimWhitespace": false,
	"telemetry.telemetryLevel": "off"
}
