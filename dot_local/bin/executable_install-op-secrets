#!/usr/bin/env zsh

# install-op-secrets
#
# Backfills private values that are no longer read at chezmoi-apply time.
# Currently backfills `git_email` from 1Password (op://dev/git/email) into the
# `[data]` section of ~/.config/chezmoi/chezmoi.toml, then re-applies chezmoi
# so templates render the real email.
#
# Run manually once `op` (1Password CLI) is installed and signed in. Safe to
# re-run: the `[data]` section is never duplicated and an existing `git_email`
# line is replaced in place (idempotent).

set -euo pipefail

CHEZMOI_TOML="${HOME}/.config/chezmoi/chezmoi.toml"
OP_REFERENCE='op://dev/git/email'

die() {
  echo "install-op-secrets: error: $*" >&2
  exit 1
}

# --- Chunk A: guard preconditions ------------------------------------------
# Fail fast BEFORE touching the chezmoi config so a misconfigured environment
# never leaves a half-written file.
if ! command -v op >/dev/null 2>&1; then
  die "'op' (1Password CLI) is not on PATH. Install and sign in first."
fi
if ! op whoami >/dev/null 2>&1; then
  die "'op' is not signed in. Run 'op signin' first."
fi

# --- Chunk B: read the secret ----------------------------------------------
if ! GIT_EMAIL="$(op read "${OP_REFERENCE}" 2>/dev/null)"; then
  die "failed to read '${OP_REFERENCE}' from 1Password."
fi
if [[ -z "${GIT_EMAIL}" ]]; then
  die "'${OP_REFERENCE}' resolved to an empty value in 1Password."
fi

# --- Chunk C: idempotently upsert git_email under [data] -------------------
# Portable awk only — no TOML dependency. Handles four cases without ever
# duplicating the [data] section:
#   (a) file absent        -> create it with [data] + key
#   (b) no [data] section  -> append [data] + key
#   (c) [data] + git_email -> replace just that one line in place
#   (d) [data], no key     -> insert the key under [data]
# Matches ONLY the exact `[data]` table header (not [data.something]).
upsert_git_email() {
  local target="$1"
  local value="$2"

  # Case (a): create the file from scratch.
  if [[ ! -f "${target}" ]]; then
    mkdir -p "$(dirname "${target}")"
    printf '[data]\ngit_email = "%s"\n' "${value}" >"${target}"
    return
  fi

  # Cases (b)/(c)/(d): rewrite atomically via a temp file in the same directory
  # (same filesystem -> atomic rename). set -e aborts before `mv` if awk fails.
  local tmp
  tmp="$(mktemp "${target}.XXXXXX")"
  awk -v email="${value}" '
    # begin-upsert-program
    BEGIN { in_data = 0; found_data = 0; wrote_key = 0 }
    /^[[:space:]]*\[/ {
      if (in_data && !wrote_key) { printf "git_email = \"%s\"\n", email; wrote_key = 1 }
      in_data = ($0 ~ /^[[:space:]]*\[data\][[:space:]]*$/)
      if (in_data) found_data = 1
      print; next
    }
    in_data && !wrote_key && /^[[:space:]]*git_email[[:space:]]*=/ {
      printf "git_email = \"%s\"\n", email; wrote_key = 1; next
    }
    { print }
    END {
      if (!wrote_key) {
        if (in_data) { printf "git_email = \"%s\"\n", email }
        else if (!found_data) { printf "\n[data]\ngit_email = \"%s\"\n", email }
      }
    }
    # end-upsert-program
  ' "${target}" >"${tmp}"
  mv "${tmp}" "${target}"
}

upsert_git_email "${CHEZMOI_TOML}" "${GIT_EMAIL}"
echo "install-op-secrets: wrote git_email into ${CHEZMOI_TOML}"

# --- Chunk D: re-apply and confirm -----------------------------------------
chezmoi apply

RESOLVED_EMAIL="$(git config user.email)"
echo "install-op-secrets: resolved git user.email = ${RESOLVED_EMAIL}"
