#!/usr/bin/env zsh

# Clones a private dotfiles repo and syncs its files into $HOME, preserving
# directory structure. Optional: if it fails (e.g. no access to the private
# repo), chezmoi apply continues regardless.

set -euo pipefail

PRIVATE_REPO_URL="${PRIVATE_DOTFILES_REPO:-git@github.com:petronetto/dotfiles-private.git}"
TEMP_DIR="${TMPDIR:-/tmp}/dotfiles-private-$$"

cleanup() {
  [[ -d "${TEMP_DIR}" ]] && rm -rf "${TEMP_DIR}"
}
trap cleanup EXIT INT TERM

main() {
  echo "ℹ️ Starting private dotfiles sync..."

  if ! git clone --depth 1 "${PRIVATE_REPO_URL}" "${TEMP_DIR}" 2>/dev/null; then
    echo "⚠️ failed to clone private dotfiles repo from ${PRIVATE_REPO_URL}, skipping" >&2
    return 0
  fi

  echo "ℹ️ Syncing private dotfiles to home directory..."
  if command -v rsync >/dev/null 2>&1; then
    rsync -av --exclude='.git' "${TEMP_DIR}/" "${HOME}/"
  else
    cp -r "${TEMP_DIR}"/.[!.]* "${HOME}/" 2>/dev/null || true
    cp -r "${TEMP_DIR}"/* "${HOME}/" 2>/dev/null || true
  fi

  echo "ℹ️ Setting permissions..."
  [[ -d "${HOME}/.ssh/config.d" ]] && chmod 700 "${HOME}/.ssh" && chmod 600 "${HOME}/.ssh/config.d"/*
  [[ -d "${HOME}/.local/bin" ]] && chmod +x "${HOME}/.local/bin"/*
  [[ -d "${HOME}/.config/zsh/private" ]] && chmod 644 "${HOME}/.config/zsh/private"/*
  [[ -d "${HOME}/.config/pi" ]] && chmod 600 "${HOME}/.config/pi/auth.json"

  echo "✅ Private dotfiles sync complete"
}

main || echo "❌ sync-private-dotfiles failed, continuing..." >&2
