#!/usr/bin/env zsh
# Persistent Docker-only Ubuntu acceptance fixture. No operation removes it.

set -euo pipefail

readonly CONTAINER='ubuntu-dotfiles-test'
readonly IMAGE='ubuntu-dotfiles-test:26.04'
readonly PLATFORM='linux/amd64'
readonly REPO="$(cd "${0:A:h}/.." && pwd)"
readonly COMPOSE_FILE="${REPO}/tests/ubuntu/docker-compose.yml"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/ubuntu-test"
readonly GUEST_SOURCE='/home/tester/.local/share/chezmoi'
readonly SHELL_COMMAND="docker exec -it --user tester ${CONTAINER} zsh -l"
SOURCE="${REPO}"
SNAPSHOT_DIR=''
SOURCE_DIGEST=''
CHECK_ARGS=()

fail() {
  print -u2 -r -- "ubuntu-test: error: $*"
  exit 1
}

compose() {
  docker compose --project-directory "${REPO}/tests/ubuntu" -f "${COMPOSE_FILE}" "$@"
}

container_exists() {
  docker inspect "${CONTAINER}" >/dev/null 2>&1
}

container_running() {
  [[ "$(docker inspect --format '{{.State.Running}}' "${CONTAINER}")" == true ]]
}

image_identity() {
  docker image inspect --format '{{.Id}}' "${IMAGE}"
}

build_snapshot() {
  mkdir -p "${STATE_DIR}"
  SNAPSHOT_DIR="$(mktemp -d "${STATE_DIR}/snapshot.XXXXXX")"
  SOURCE_DIGEST="$(zsh "${REPO}/scripts/ubuntu-snapshot" "${SOURCE}" "${SNAPSHOT_DIR}")"
}

record_manifest() {
  local image="$1"
  jq -n --arg digest "${SOURCE_DIGEST}" --arg image "${image}" \
    --arg platform "${PLATFORM}" --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --rawfile files "${SNAPSHOT_DIR}/files" \
    '{source_digest: $digest, image: $image, platform: $platform, created: $created,
      files: ($files | split("\u0000") | map(select(length > 0)))}' > "${SNAPSHOT_DIR}/manifest.json"
  cp "${SNAPSHOT_DIR}/manifest.json" "${STATE_DIR}/manifest.json"
}

require_matching_container() {
  local actual expected
  actual="$(docker inspect --format '{{ index .Config.Labels "dotfiles.source-digest" }}|{{.Image}}' "${CONTAINER}")"
  expected="${SOURCE_DIGEST}|$(image_identity)"
  [[ "${actual}" == "${expected}" ]] ||
    fail "fingerprint mismatch: retained=${actual} current=${expected}; container preserved, replacement requires separate approval"
}

print_summary() {
  print -r -- "container: ${CONTAINER}"
  print -r -- "shell: ${SHELL_COMMAND}"
  if [[ -f "${STATE_DIR}/manifest.json" ]]; then
    jq -r '"source digest: \(.source_digest)\nimage: \(.image)\nplatform: \(.platform)"' "${STATE_DIR}/manifest.json"
  fi
  print -r -- 'retained: installed files persist across stop/start; running sessions do not'
}

resume_container() {
  require_matching_container
  if ! container_running; then
    docker start "${CONTAINER}" >/dev/null
  fi
  print -r -- 'reusing matching container; manual state is preserved'
}

prepare() {
  build_snapshot
  if container_exists; then
    resume_container
    print_summary
    return
  fi
  compose build
  local image
  image="$(image_identity)"
  export UBUNTU_TEST_SOURCE_DIGEST="${SOURCE_DIGEST}"
  compose up -d --no-build --no-recreate
  require_matching_container
  docker exec --user root "${CONTAINER}" mkdir -p /opt/dotfiles-fixture
  docker exec --user tester "${CONTAINER}" mkdir -p "${GUEST_SOURCE}"
  docker cp "${SNAPSHOT_DIR}/source.tar" "${CONTAINER}:/opt/dotfiles-fixture/source.tar"
  docker exec --user tester "${CONTAINER}" bsdtar -xf /opt/dotfiles-fixture/source.tar -C "${GUEST_SOURCE}"
  record_manifest "${image}"
  docker cp "${STATE_DIR}/manifest.json" "${CONTAINER}:/opt/dotfiles-fixture/manifest.json"
  print_summary
  print -r -- 'source prepared; package provisioning and CLI acceptance are separate, not yet passed'
}

start() {
  container_exists || fail 'no retained container; run scripts/ubuntu-test prepare'
  build_snapshot
  resume_container
}

check() {
  start
  local code=0
  docker exec --user tester "${CONTAINER}" zsh -f "${GUEST_SOURCE}/tests/ubuntu/check.zsh" "${CHECK_ARGS[@]}" || code=$?
  docker cp "${CONTAINER}:/home/tester/.local/state/dotfiles/ubuntu-test/report.json" "${STATE_DIR}/report.json" ||
    fail 'smoke run did not produce a readable report; CLI acceptance has not passed'
  print_summary
  print -r -- "report: ${STATE_DIR}/report.json"
  return "${code}"
}

main() {
  local operation="${1:-}"
  (( $# == 0 )) || shift
  while (( $# )); do
    (( $# >= 2 )) && [[ -n "$2" && "$2" != -* ]] || fail "incomplete option: $1"
    case "$1" in
      --source) SOURCE="$2" ;;
      --only)
        [[ "${operation}" == check ]] || fail '--only is valid for check only'
        CHECK_ARGS=(--only "$2")
        ;;
      *) fail "unknown option: $1" ;;
    esac
    shift 2
  done
  case "${operation}" in
    prepare) prepare ;;
    start) start; print_summary ;;
    shell) start; docker exec -it --user tester "${CONTAINER}" zsh -l ;;
    check) check ;;
    status)
      if ! container_exists; then print 'status: not created'; return; fi
      docker inspect --format '{{.State.Status}}' "${CONTAINER}"
      print_summary
      ;;
    logs) docker logs --tail 200 "${CONTAINER}" ;;
    stop)
      container_exists || fail 'no retained container'
      docker stop "${CONTAINER}" >/dev/null
      print 'stopped; container files are preserved'
      ;;
    *) fail 'usage: scripts/ubuntu-test <prepare|check|start|status|shell|logs|stop> [--source <Git root>]' ;;
  esac
}

main "$@"
