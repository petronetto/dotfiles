#!/usr/bin/env zsh

# Create XDG Base Directory Specification directories
# These directories are defined in ~/.config/zsh/.zshenv

echo "ℹ️ Creating XDG Base Directory Specification directories..."

# XDG directories
mkdir -p "$HOME/.config"
mkdir -p "$HOME/.local/share"
mkdir -p "$HOME/.cache"
mkdir -p "$HOME/.cache/run"

# ZSH configuration directory
mkdir -p "$HOME/.config/zsh"

# Create ~/code directory and set ownership to current user
echo "ℹ️ Creating $HOME/code directory..."
if [[ ! -d "$HOME/code" ]]; then
  mkdir -p "$HOME/code"
else
  echo "✅ $HOME/code already exists"
fi

echo "✅ XDG directories created"
