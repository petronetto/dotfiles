#!/usr/bin/env zsh
#
# Local wrapper around the `skills` CLI (https://skills.sh).
#
# Skills come in two kinds:
#   - custom (7):    committed under dot_agents/skills/, deployed by chezmoi.
#   - third-party:   installed by this wrapper into the live ~/.agents/skills/
#                    and never committed. Their set is recorded in the committed
#                    manifest dot_agents/.skill-lock.json.
#
# Management commands target the global dir of the `zed` agent (~/.agents/skills),
# the directory pi reads as its user-skill dir. The `universal` agent instead
# writes to ~/.config/agents/skills, which pi ignores, so it must not be used.
#
# Mutating commands (add/update/remove) re-sync the committed manifest from the
# CLI's live lock (~/.agents/.skill-lock.json) afterwards; commit it when ready.
# `restore` reinstalls any manifest skill missing on disk (idempotent).
#
#   scripts/skills add <owner/repo> [--skill <name>]
#   scripts/skills update
#   scripts/skills remove <name>
#   scripts/skills list [--global --agent zed]
#   scripts/skills restore

set -euo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
MANIFEST="$REPO/dot_agents/.skill-lock.json"
LIVE_LOCK="$HOME/.agents/.skill-lock.json"
LIVE_SKILLS="$HOME/.agents/skills"

command -v jq >/dev/null 2>&1 || { echo "skills: jq is required (brew install jq)" >&2; exit 1; }

# Invoke the real skills CLI. Scope/agent flags are added per-subcommand below:
# the CLI does not accept --agent uniformly (e.g. `update` has no --agent option).
run() {
	DISABLE_TELEMETRY=true command npx --yes skills "$@"
}

# Seed an empty/missing live lock from the committed manifest before a mutation,
# so a stale empty live lock can never blank a populated manifest on sync.
seed_live_lock() {
	local live_len manifest_len
	live_len=$(jq '.skills | length' "$LIVE_LOCK" 2>/dev/null || echo 0)
	manifest_len=$(jq '.skills | length' "$MANIFEST" 2>/dev/null || echo 0)
	if (( live_len == 0 && manifest_len > 0 )); then
		mkdir -p "$(dirname "$LIVE_LOCK")"
		cp "$MANIFEST" "$LIVE_LOCK"
	fi
}

# Reflect the CLI's live lock back into the committed manifest after a mutation.
sync_manifest() {
	[[ -f "$LIVE_LOCK" ]] || { echo "skills: no live lock to sync from" >&2; return 0; }
	cp "$LIVE_LOCK" "$MANIFEST"
	echo "skills: manifest synced; commit dot_agents/.skill-lock.json when ready." >&2
}

main() {
	if (( $# == 0 )); then
		run --help
		return
	fi

	local sub=$1
	shift

	case "$sub" in
	add)
		seed_live_lock
		run add "$@" --global --agent zed
		sync_manifest
		;;
	update | upgrade)
		seed_live_lock
		# `update` has no --agent option; --global scopes it to ~/.agents/skills.
		run "$sub" "$@" --global
		sync_manifest
		;;
	remove | rm)
		seed_live_lock
		run "$sub" "$@" --global --agent zed
		sync_manifest
		;;
	restore)
		seed_live_lock
		local skill source installed=0 failed=0
		while IFS= read -r skill; do
			if [[ -d "$LIVE_SKILLS/$skill" ]]; then
				continue
			fi
			source=$(jq -r --arg s "$skill" '.skills[$s].source' "$MANIFEST")
			echo "skills: restoring $skill from ${source}" >&2
			if run add "$source" --skill "$skill" --global --agent zed -y; then
				installed=$((installed + 1))
			else
				echo "skills: WARNING failed to restore $skill" >&2
				failed=$((failed + 1))
			fi
		done < <(jq -r '.skills | keys[]' "$MANIFEST")
		sync_manifest
		echo "skills: restore complete ($installed installed, $failed failed)." >&2
		if (( failed > 0 )); then
			return 1
		fi
		;;
	*)
		# Read-only and pass-through commands (list, find, init, use, help, ...).
		run "$sub" "$@"
		;;
	esac
}

main "$@"
