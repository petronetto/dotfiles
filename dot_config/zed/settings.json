// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "cursor": {
      "default_config_options": {
        "model": "claude-sonnet-5[thinking=true,context=300k,effort=high]"
      },
      "type": "custom",
      "command": "/opt/homebrew/bin/cursor-agent",
      "args": ["acp"]
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "high",
        "model": "sonnet"
      },
      "type": "registry"
    }
  },
  "tabs": {
    "git_status": true
  },
  "title_bar": {
    "show_menus": false,
    "show_user_menu": false,
    "show_user_picture": false,
    "show_sign_in": false
  },
  "disable_ai": false,
  "edit_predictions": {
    "mode": "subtle",
    "allow_data_collection": "no",
    "ollama": {
      "model": "qwen2.5-coder:1.5b"
    },
    "provider": "ollama"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "show_turn_stats": true,
    "enable_feedback": false,
    "default_profile": "ask",
    "default_model": {
      "provider": "ollama",
      "model": "qwen3.8:27b-mlx",
      "enable_thinking": true
    },
    "favorite_models": [
      {
        "provider": "ollama",
        "model": "glm-4.7-flash:latest",
        "enable_thinking": true
      },
      {
        "provider": "ollama",
        "model": "qwen3.8:27b-mlx",
        "enable_thinking": true
      },
      {
        "provider": "ollama",
        "model": "qwen3-coder:30b",
        "enable_thinking": false
      },
      {
        "provider": "ollama",
        "model": "ornith:35b",
        "enable_thinking": true
      },
      {
        "provider": "ollama",
        "model": "gemma4:31b-mlx",
        "enable_thinking": true
      }
    ],
    "model_parameters": []
  },
  "icon_theme": "Material Icon Theme",
  "text_rendering_mode": "grayscale",
  "markdown_preview_code_font_family": ".ZedSans",
  "buffer_font_weight": 350.0,
  "agent_ui_font_size": 16.0,
  "cli_default_open_behavior": "new_window",
  "proxy": "",
  "project_panel": {
    "auto_fold_dirs": false,
    "folder_icons": true,
    "hide_gitignore": true,
    "dock": "left"
  },
  "buffer_font_family": "CaskaydiaCove Nerd Font",
  "buffer_font_features": {
    "calt": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss19": true,
    "ss20": true
  },
  "ui_font_size": 20.0,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Material Light Mix",
    "dark": "Gruvbox Material Dark Mix"
  },
  "auto_install_extensions": {
    "html": true,
    "php": true,
    "yaml": true,
    "toml": true,
    "dockerfile": true,
    "docker-compose": true,
    "blade": true,
    "env": true,
    "git-firefly": true,
    "gruvbox-material-mix": true,
    "ini": true,
    "material-icon-theme": true,
    "nginx": true,
    "scss": true,
    "sql": true,
    "templ": true,
    "twig": true
  },
  "languages": {
    "PHP": {
      "language_servers": [
        "phpantom",
        "!phpactor",
        "!intelephense",
        "!phptools"
      ]
    }
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "php": "html",
          "blade": "html"
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class=\\\"([^\\\"]*)\\\"",
            "@class\\(\\[([^\\]]*)\\]\\)"
          ]
        }
      }
    }
  }
}
