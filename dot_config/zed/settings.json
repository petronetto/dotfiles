// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": "Material Icon Theme",
  "text_rendering_mode": "grayscale",
  "markdown_preview_code_font_family": ".ZedSans",
  "buffer_font_weight": 350.0,
  "agent_ui_font_size": 16.0,
  "cli_default_open_behavior": "new_window",
  "proxy": "",
  "project_panel": {
    "hide_gitignore": false,
    "dock": "left"
  },
  "buffer_font_family": "CaskaydiaCove Nerd Font",
  "buffer_font_features": {
    "calt": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss19": true,
    "ss20": true
  },
  "ui_font_size": 20.0,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Material Dark Mix",
    "dark": "Gruvbox Material Dark Mix"
  },
  "auto_install_extensions": {
    "html": true,
    "php": true,
    "yaml": true,
    "toml": true,
    "dockerfile": true,
    "docker-compose": true
  },
  "languages": {
    "PHP": {
      "language_servers": [
        "phpantom",
        "!phpactor",
        "!intelephense",
        "!phptools"
      ]
    }
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "php": "html",
          "blade": "html"
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class=\\\"([^\\\"]*)\\\"",
            "@class\\(\\[([^\\]]*)\\]\\)"
          ]
        }
      }
    }
  }
}
