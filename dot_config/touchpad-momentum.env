# Settings for ~/.local/bin/touchpad-momentum. Edit them in the dotfiles source,
# then run chezmoi apply and `systemctl --user restart touchpad-momentum`.
#
# More momentum: raise TPM_GAIN (distance) or TPM_TAU (how long it coasts).
# Momentum runs the wrong way: set TPM_DIRECTION=-1.
TPM_GAIN=22
TPM_TAU=0.35
TPM_MIN_SPEED=40
TPM_MAX_SPEED=600
TPM_DIRECTION=1
# Window classes that get momentum; other apps already coast on their own.
TPM_CLASSES=ghostty|zed
