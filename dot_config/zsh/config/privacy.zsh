#!/usr/bin/env zsh

# Disable tracking
export DO_NOT_TRACK=1

# Disable telemetry
export TELEMETRY_DISABLED=1
export TELEMETRY_OPT_OUT=1
export TELEMETRY=0

# Disable usage tracking
export USAGE_TRACKING_OPT_OUT=1

# Disable analytics
export ANALYTICS_OPT_OUT=1
export ANALYTICS=false

# Disable logging
export LOGGING_OPT_OUT=1

# Disable crash reporting
export CRASH_REPORTING_OPT_OUT=1
