[user]
	name = Juliano Petronetto
	email = {{ .git_email }}
	signingkey = {{ include "private_dot_ssh/private_petronetto.pub" | trim }}

[core]
	sshCommand = "ssh -i ~/.ssh/petronetto.pub -o IdentitiesOnly=yes"
	excludesFile = ~/.config/git/ignore

[gpg]
  format = ssh

[gpg "ssh"]
  program = {{ if eq .chezmoi.os "darwin" }}"/Applications/1Password.app/Contents/MacOS/op-ssh-sign"{{ else }}"/opt/1Password/op-ssh-sign"{{ end }}

[commit]
  gpgsign = true

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[init]
	defaultBranch = main

[includeIf "gitdir:~/code/work/"]
	path = ~/.config/git/config-work
