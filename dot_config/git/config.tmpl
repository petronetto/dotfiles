[user]
	name = Juliano Petronetto
	email = {{ .git_email }}
	signingkey = {{ include "private_dot_ssh/private_petronetto.pub" | trim }}

[core]
	sshCommand = "ssh -i ~/.ssh/petronetto.pub -o IdentitiesOnly=yes"
	excludesFile = ~/.config/git/ignore

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
  gpgsign = true

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[init]
	defaultBranch = main

[includeIf "gitdir:/opt/code/work/"]
	path = ~/.config/git/config-work
