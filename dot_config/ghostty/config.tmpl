# Shared
theme = Gruvbox Custom
font-family = JetBrainsMono NFM Light
maximize = true
mouse-hide-while-typing = true
background-opacity = 0.8
background-blur-radius = 30
background-opacity-cells = true
keybind = shift+enter=text:\n
window-inherit-working-directory = true
window-padding-y = 20
window-padding-x = 20
working-directory = ~/code

{{ if eq .chezmoi.os "darwin" -}}
# macOS
font-size = 20
keybind = global:cmd+shift+space=toggle_quick_terminal
macos-titlebar-style = hidden
# Enable Option key as Alt for keybindings
# Use 'left' so right Option key can still type special characters
macos-option-as-alt = left
{{ else -}}
# Ubuntu
font-size = 14
gtk-titlebar = false
# precision compensates the system-wide touchpad scroll factor (scripts/ubuntu/configure-scroll-speed).
# discrete is one row per notch, so the momentum of touchpad-momentum is not tripled.
mouse-scroll-multiplier = precision:2,discrete:1
keybind = ctrl+shift+space=toggle_quick_terminal
# keyd swaps Ctrl and Cmd on the Apple keyboard: the physical Cmd key reaches
# Ghostty as ctrl and the physical Ctrl key as super. Cmd+V pastes and Ctrl+C
# always interrupts. Cmd+C copies a Ghostty selection; with none it passes through,
# so Herdr copies its own selection, and any other program sees an interrupt.
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = super+c=text:\x03
{{ end -}}
